{
  "name": "safwaan-ai-studio",
  "version": "2.0.0",
  "description": "Safwaan AI Studio - AI-powered content creation platform",
  "main": "src/index.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "dev": "concurrently \"npm run start\" \"npm run server\"",
    "server": "node server.js",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write src/**/*.{js,jsx,ts,tsx,json,css,md}",
    "type-check": "tsc --noEmit",
    "analyze": "npm run build && npx serve -s build -l 3001",
    "storybook": "start-storybook -p 6006 -s public",
    "build-storybook": "build-storybook",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "test:coverage": "npm run test -- --coverage --watchAll=false",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "docker:build": "docker build -t cinematrix-studio .",
    "docker:run": "docker run -p 3000:3000 cinematrix-studio",
    "deploy:staging": "vercel --prod=false",
    "deploy:production": "vercel --prod=true"
  },
